{
  "name": "najatalk",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend && npm run build --prefix backend",
    "lint": "npm run lint --prefix frontend",
    "test": "npm test --prefix backend",
    "ci:backend": "npm test --prefix backend",
    "ci:frontend": "npm run lint --prefix frontend && npm run typecheck --prefix frontend && npm run build --prefix frontend",
    "ci:p0": "npm run ci:backend && npm run ci:frontend",
    "ops:synthetic": "node scripts/synthetic_monitor.mjs",
    "ops:e2e:smoke": "node scripts/e2e_smoke.mjs",
    "ops:e2e:ui": "npm run e2e:ui --prefix frontend",
    "ops:retention:report": "npm run retention:report --prefix backend",
    "ops:drill:rollback:capture": "bash scripts/drill_capture_post_rollback.sh",
    "ops:drill:restore:capture": "bash scripts/drill_capture_post_restore.sh",
    "dev:proxy": "node vercel-dev.js",
    "start": "concurrently \"npm start --prefix frontend\" \"npm start --prefix backend\"",
    "vercel-build": "npm run build"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
